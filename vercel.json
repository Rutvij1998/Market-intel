{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/ingest",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/notifications/run",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/notifications/run",
      "schedule": "30 1 * * *"
    }
  ],
  "functions": {
    "app/api/cron/ingest/route.ts": {
      "maxDuration": 300
    },
    "app/api/notifications/run/route.ts": {
      "maxDuration": 300
    },
    "app/api/ingest/all/route.ts": {
      "maxDuration": 300
    }
  }
}
