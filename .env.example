# === Reddit API (script app) ===
# IMPORTANT: For "script" type apps, you MUST also provide username and password
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=script:likewize-market-intel:v1.0 (by /u/your_reddit_username)
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_account_password
# IMPORTANT FOR AUTH ("Invalid grant" fix):
# - App at https://www.reddit.com/prefs/apps MUST be type "script" (not web/installed)
# - The Reddit ACCOUNT MUST HAVE 2FA DISABLED (password grant used by script apps does not support 2FA)
# - After fixing, restart `npm run dev`

# === Gemini API (for sentiment + pillar classification) ===
GEMINI_API_KEY=your_gemini_api_key

# === Hugging Face fallback (pre-trained model for sentiment) ===
# Used automatically if no GEMINI_API_KEY or Gemini fails.
# Get token: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_hf_token_here

# Optional: force the HF fallback path even when GEMINI_API_KEY exists (great for testing)
# FORCE_HF_FALLBACK=true

# (Optional) Fallback to xAI/Grok only if no GEMINI_API_KEY is set
# XAI_API_KEY=your_xai_key_here

# === Supabase (create project at supabase.com) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# === Clerk (optional) ===
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# === Cron Job Protection (for /api/cron/ingest) ===
# Generate a long random string (e.g. openssl rand -hex 32)
CRON_SECRET=change-me-to-a-long-random-string-32-chars-or-more