# === Reddit API (script app) ===
# IMPORTANT: For "script" type apps, you MUST also provide username and password
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=script:market-vantage:v1.0 (by /u/your_reddit_username)
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_account_password
# IMPORTANT FOR AUTH ("Invalid grant" fix):
# - App at https://www.reddit.com/prefs/apps MUST be type "script" (not web/installed)
# - The Reddit ACCOUNT MUST HAVE 2FA DISABLED (password grant used by script apps does not support 2FA)
# - After fixing, restart `npm run dev`

# === Hugging Face (sentiment classification — required) ===
# Create a fine-grained token at https://huggingface.co/settings/tokens
# Enable permission: "Make calls to the Inference Providers"
# Classic "read" tokens get HTTP 403 on the new router API.
HUGGINGFACE_API_KEY=hf_your_token_here

# === Supabase (create project at supabase.com) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# === Dashboard login (shared credentials) ===
# Defaults if unset: username Likewize / password Likewize2026!
DASHBOARD_USERNAME=Likewize
DASHBOARD_PASSWORD=Likewize2026!
# Used to sign the session cookie — set a long random string in production
AUTH_SECRET=change-me-to-a-long-random-string

# === Email alerts (PDF digests for client / business-line enrollments) ===
# Option A — Resend (https://resend.com): verify a domain, then:
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Market Vantage <alerts@your-domain.com>"
# Option B — SMTP (preferred if you cannot verify a domain on Resend):
# Gmail: enable 2FA, create App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=market.vantage.noreply@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="Market Vantage <market.vantage.noreply@gmail.com>"
EMAIL_FROM="Market Vantage <market.vantage.noreply@gmail.com>"
# Public URL used in unsubscribe links + live dashboard screenshots for email PDFs
# Must be the production URL (not localhost) on deploy
NEXT_PUBLIC_APP_URL=https://market-intel-mauve.vercel.app

# === Cron Job Protection (for /api/cron/ingest) ===
# Generate a long random string (e.g. openssl rand -hex 32)
CRON_SECRET=change-me-to-a-long-random-string-32-chars-or-more